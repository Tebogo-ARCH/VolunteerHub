@model VolunteerHub.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    :root {
        --vh-cream: #FFF1E8;
        --vh-light-blue: #8FAADC;
        --vh-blue: #2F5DA8;
        --vh-navy: #0C1F3F;
    }

    html, body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        background: var(--vh-navy);
    }

    .vh-reset-page {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 25px;
        overflow: hidden;
        box-sizing: border-box;
        background: linear-gradient( 135deg, var(--vh-navy) 0%, var(--vh-blue) 65%, var(--vh-light-blue) 100% );
    }

    .vh-reset-circle {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        background: rgba(255, 241, 232, 0.08);
    }

    .vh-reset-circle-one {
        width: 420px;
        height: 420px;
        top: -200px;
        left: -150px;
    }

    .vh-reset-circle-two {
        width: 400px;
        height: 400px;
        bottom: -200px;
        right: -150px;
    }

    .vh-reset-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 460px;
    }

    .vh-reset-card {
        padding: 38px;
        border-radius: 14px;
        background: rgba(255, 241, 232, 0.97);
        box-shadow: 0 25px 60px rgba(12, 31, 63, 0.45);
        box-sizing: border-box;
    }

    .vh-reset-logo {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--vh-navy);
        border: 5px solid var(--vh-light-blue);
        color: var(--vh-cream);
        font-size: 28px;
        font-weight: 800;
    }

    .vh-reset-brand {
        text-align: center;
        margin: 0 0 5px;
        font-size: 34px;
        font-weight: 800;
        color: var(--vh-navy);
    }

    .vh-reset-subtitle {
        text-align: center;
        margin: 0 0 25px;
        color: var(--vh-blue);
        font-size: 15px;
    }

    .vh-reset-label {
        display: block;
        margin-bottom: 7px;
        color: var(--vh-navy);
        font-size: 14px;
        font-weight: 700;
    }

    .vh-reset-input {
        width: 100%;
        height: 48px;
        padding: 10px 14px;
        box-sizing: border-box;
        border: 1px solid var(--vh-light-blue);
        border-radius: 7px;
        background: white;
        color: var(--vh-navy);
        outline: none;
    }

        .vh-reset-input:focus {
            border-color: var(--vh-blue);
            box-shadow: 0 0 0 3px rgba(47, 93, 168, 0.18);
        }

    .vh-reset-group {
        margin-bottom: 20px;
    }

    .vh-reset-validation {
        display: block;
        margin-top: 6px;
        font-size: 13px;
        color: #a52a2a;
    }

    .vh-reset-summary {
        margin-bottom: 18px;
        padding: 10px 12px;
        border-radius: 7px;
        background: #f8dddd;
        color: #8b1e1e;
        font-size: 14px;
    }

    .vh-reset-message {
        margin-bottom: 20px;
        padding: 12px;
        border-radius: 7px;
        background: #e3eddf;
        color: #244d2b;
        font-size: 14px;
    }

    .vh-reset-submit {
        width: 100%;
        min-height: 50px;
        border: none;
        border-radius: 7px;
        background: var(--vh-blue);
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .vh-reset-submit:hover {
            background: var(--vh-navy);
            transform: translateY(-2px);
        }

    .vh-reset-link {
        display: block;
        text-align: center;
        margin-top: 22px;
        color: var(--vh-blue);
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

        .vh-reset-link:hover {
            color: var(--vh-navy);
            text-decoration: underline;
        }

    .vh-reset-footer {
        text-align: center;
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px solid rgba(12, 31, 63, 0.12);
        color: #5b6b82;
        font-size: 12px;
    }

    @@media (max-width: 600px) {
        .vh-reset-card {
            padding: 30px 25px;
        }

        .vh-reset-brand {
            font-size: 30px;
        }
    }
</style>

<div class="vh-reset-page">

    <!-- Decorative background circles -->
    <div class="vh-reset-circle vh-reset-circle-one"></div>
    <div class="vh-reset-circle vh-reset-circle-two"></div>

    <div class="vh-reset-content">
        <div class="vh-reset-card">

            <!-- VolunteerHub logo and heading -->
            <div class="vh-reset-logo">V</div>

            <h1 class="vh-reset-brand">VolunteerHub</h1>

            <p class="vh-reset-subtitle">
                Recover access to your account
            </p>

            @if (ViewBag.Message != null)
            {
                <div class="vh-reset-message">
                    @ViewBag.Message
                </div>
            }

            <div asp-validation-summary="ModelOnly"
                 class="vh-reset-summary">
            </div>

            <!-- Email address form -->
            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="vh-reset-group">
                    <label asp-for="Email" class="vh-reset-label">
                        Registered Email Address
                    </label>

                    <input asp-for="Email"
                           class="vh-reset-input"
                           type="email"
                           placeholder="Enter your email address"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="vh-reset-validation">
                    </span>
                </div>

                <button type="submit" class="vh-reset-submit">
                    Request Password Reset
                </button>
            </form>

            <!-- Local development testing only -->
            @if (ViewBag.ResetLink != null)
            {
                <div class="vh-reset-message mt-4">
                    <strong>Local testing reset link</strong>

                    <p class="mb-2 mt-2">
                        This link is shown for development testing.
                        It expires after 30 minutes.
                    </p>

                    <a href="@ViewBag.ResetLink"
                       class="fw-bold text-break">
                        Open Reset Password Page
                    </a>
                </div>
            }

            <a asp-controller="Account"
               asp-action="Login"
               class="vh-reset-link">
                Back to Login
            </a>

            <div class="vh-reset-footer">
                VolunteerHub Volunteer Management Platform
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}