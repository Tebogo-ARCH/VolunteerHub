@{
    ViewData["Title"] = "Invalid Reset Link";
}

<style>
    :root {
        --vh-cream: #FFF1E8;
        --vh-light-blue: #8FAADC;
        --vh-blue: #2F5DA8;
        --vh-navy: #0C1F3F;
    }

    html, body {
        min-height: 100%;
        margin: 0;
        background: var(--vh-navy);
    }

    .vh-invalid-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 25px;
        box-sizing: border-box;
        background: linear-gradient( 135deg, var(--vh-navy) 0%, var(--vh-blue) 65%, var(--vh-light-blue) 100% );
    }

    .vh-invalid-card {
        width: 100%;
        max-width: 460px;
        padding: 38px;
        text-align: center;
        border-radius: 14px;
        background: rgba(255, 241, 232, 0.97);
        box-shadow: 0 25px 60px rgba(12, 31, 63, 0.45);
        box-sizing: border-box;
    }

    .vh-invalid-logo {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--vh-navy);
        border: 5px solid var(--vh-light-blue);
        color: var(--vh-cream);
        font-size: 28px;
        font-weight: 800;
    }

    .vh-invalid-title {
        color: var(--vh-navy);
        font-size: 27px;
        font-weight: 800;
    }

    .vh-invalid-text {
        color: #475569;
        line-height: 1.6;
    }

    .vh-invalid-button {
        display: block;
        width: 100%;
        margin-top: 22px;
        padding: 14px;
        border-radius: 7px;
        background: var(--vh-blue);
        color: white;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease;
    }

        .vh-invalid-button:hover {
            background: var(--vh-navy);
            color: white;
        }
</style>

<div class="vh-invalid-page">
    <div class="vh-invalid-card">

        <div class="vh-invalid-logo">V</div>

        <h1 class="vh-invalid-title">
            Reset Link Unavailable
        </h1>

        <p class="vh-invalid-text">
            This password reset link is invalid, has expired, or has
            already been used. Request a new reset link to continue.
        </p>

        <a asp-controller="Account"
           asp-action="ForgotPassword"
           class="vh-invalid-button">
            Request a New Reset Link
        </a>

        <a asp-controller="Account"
           asp-action="Login"
           class="d-block mt-3 text-decoration-none"
           style="color: #2F5DA8;">
            Back to Login
        </a>

    </div>
</div>