
@model List<VolunteerHub.Models.Announcement>

@{
    ViewData["Title"] = "Organization Communication";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="vh-dashboard-header mb-4">
        <div class="p-4">
            <div class="small text-uppercase fw-semibold mb-2"
                 style="letter-spacing: 1px; color: #8FAADC;">
                VolunteerHub Staff Portal
            </div>

            <h1 class="mb-2">Organization Communication</h1>

            <p class="mb-1">
                Welcome,
                <strong>@ViewBag.FirstName @ViewBag.LastName</strong>
            </p>

            <p class="mb-0">
                Organization:
                <strong>@ViewBag.OrganizationName</strong>
            </p>
        </div>
    </div>

    <!-- MESSAGES -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4">
        <h4 class="fw-bold" style="color: #0C1F3F;">
            Announcements
        </h4>

        <p class="text-muted">
            Read announcements shared by your organization.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card vh-cream-panel mb-4">
            <div class="card-body p-4 text-center">
                <h5>No announcements yet</h5>

                <p class="text-muted mb-0">
                    Your organization has not shared any communications yet.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var announcement in Model)
            {
                <div class="col-md-6 col-xl-4 mb-4">
                    <div class="card vh-dashboard-card h-100">
                        <div class="card-body d-flex flex-column">

                            <span class="badge bg-secondary align-self-start mb-3">
                                COMMUNICATION
                            </span>

                            <h5 class="card-title">
                                @announcement.Title
                            </h5>

                            <p class="text-muted">
                                @{
                                    var preview = announcement.Content ?? "";
                                }

                                @(preview.Length > 160
                                    ? preview.Substring(0, 160) + "..."
                                    : preview)
                            </p>

                            <p class="small text-muted mt-auto">
                                Published:
                                @(announcement.CreatedAt?.ToString("dd MMM yyyy, HH:mm")
                                    ?? "Date unavailable")
                            </p>

                            <a asp-controller="StaffCommunication"
                               asp-action="Details"
                               asp-route-id="@announcement.AnnId"
                               class="btn btn-primary align-self-start">
                                Read Announcement
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- BACK TO STAFF DASHBOARD -->
    <div class="mt-3 mb-4">
        <a asp-controller="Staff"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>
