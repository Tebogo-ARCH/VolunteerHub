@model VolunteerHub.Models.Organization
@{
    ViewData["Title"] = "My Organization";
}
<div class="container mt-5">

    <!-- PAGE HEADER -->

    <div class="text-center mb-5">
        <h1>My Organization</h1>
        <p class="lead">
            Organization information and details
        </p>
        <p>
            Manager:
            <strong>
                @ViewBag.FirstName @ViewBag.LastName
            </strong>
        </p>
    </div>

    <!-- ORGANIZATION INFORMATION-->

    <div class="card shadow mb-4">

        <!-- ORGANIZATION HEADER-->

        <div class="card-header table-primary text-center">
            <h3 class="mb-0">
                @Model.OrgName
            </h3>
        </div>

        <!-- ORGANIZATION DETAILS-->
        
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <strong>Organization ID</strong>
                    <p class="mb-0">
                        @Model.Oid
                    </p>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>Organization Name</strong>
                    <p class="mb-0">
                        @Model.OrgName
                    </p>
                </div>
                <div class="col-12 mb-4">
                    <strong>Description</strong>
                    <p class="mb-0">

                        @* Checks whether the description contains non-blank text. *@
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-muted">
                                No description available.
                            </span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTACT INFORMATION-->

    <div class="card shadow mb-4">
        <div class="card-header table-primary">
            <h4 class="mb-0">
                Contact Information
            </h4>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Email</strong>
                    <p class="mb-0">

                        @* Check if email is there *@
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            @Model.Email
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }
                    </p>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Phone</strong>
                    <p class="mb-0">
                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                        {
                            @Model.Phone
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ORGANIZATION ADDRESS-->

    <div class="card shadow mb-4">
        <div class="card-header table-primary">
            <h4 class="mb-0">
                Organization Address
            </h4>
        </div>
        <div class="card-body">
            @if (Model.Address != null)
            {
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <strong>Street Address</strong>
                        <p class="mb-0">
                            @Model.Address.StreetAddress
                        </p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <strong>Suburb</strong>
                        <p class="mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.Address.Suburb))
                            {
                                @Model.Address.Suburb
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not provided
                                </span>
                            }
                        </p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <strong>City</strong>
                        <p class="mb-0">
                            @Model.Address.City
                        </p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <strong>Province</strong>
                        <p class="mb-0">
                            @Model.Address.Province
                        </p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <strong>Postal Code</strong>
                        <p class="mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.Address.PostalCode))
                            {
                                @Model.Address.PostalCode
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not provided
                                </span>
                            }
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center p-4">
                    <p class="text-muted mb-0">
                        No organization address has been assigned.
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- MANAGER INFORMATION-->

    <div class="card shadow mb-4">
        <div class="card-header table-primary">
            <h4 class="mb-0">
                Manager Information
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Manager</strong>
                    <p class="mb-0">
                        @ViewBag.FirstName @ViewBag.LastName
                    </p>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Manager ID</strong>
                    <p class="mb-0">
                        @ViewBag.Mid
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BUTTONS-->

    <div class="text-center mb-5">
        <a asp-controller="ManagerOrganization"
           asp-action="Edit"
           class="btn btn-primary me-2">
            Edit Organization
        </a>
        <a asp-controller="Manager"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>
</div>
