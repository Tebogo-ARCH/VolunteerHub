@model VolunteerHub.Models.Report
@{
    ViewData["Title"] = "Report Details";
}
<div class="container-fluid py-4">

    <!-- PAGE HEADER -->

    <div class="vh-dashboard-header mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="small text-uppercase fw-semibold mb-2"
                     style="letter-spacing: 1px; color: #8FAADC;">
                    VolunteerHub Management
                </div>
                <h1 class="mb-2">
                    Volunteer Report
                </h1>
                <p class="mb-2">
                    Report details and certificate management.
                </p>
                <p class="mb-0">
                    Manager:
                    <strong>
                        @ViewBag.FirstName @ViewBag.LastName
                    </strong>
                </p>
            </div>
        </div>
    </div>

    <!-- SUCCESS -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <strong>Success:</strong>
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    <!-- ERROR -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <strong>Error:</strong>
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- REPORT INFORMATION -->

    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold">
                    Report Information
                </span>
                <span class="badge bg-light text-dark">
                    Report ID: @Model.ReportId
                </span>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <strong>
                        Volunteer
                    </strong>
                    <div class="mt-1">
                        @Model.VidNavigation?.PidNavigation?.FirstName
                        @Model.VidNavigation?.PidNavigation?.LastName
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>
                        Volunteer ID
                    </strong>
                    <div class="mt-1">
                        @Model.Vid
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>
                        Project
                    </strong>
                    <div class="mt-1">
                        @Model.Project?.ProjectName
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>
                        Project ID
                    </strong>
                    <div class="mt-1">
                        @Model.ProjectId
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>
                        Total Hours
                    </strong>
                    <div class="mt-1">
                        @Model.TotalHours?.ToString("0.00")
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>
                        Report Status
                    </strong>
                    <div class="mt-1">
                        @if (Model.Status == "GENERATED")
                        {
                            <span class="badge bg-success">
                                GENERATED
                            </span>
                        }
                        else if (Model.Status == "PENDING")
                        {
                            <span class="badge bg-warning text-dark">
                                PENDING
                            </span>
                        }
                        else if (Model.Status == "REJECTED")
                        {
                            <span class="badge bg-danger">
                                REJECTED
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <strong>
                        Project Status
                    </strong>
                    <div class="mt-1">
                        @if (Model.Project?.Status == "COMPLETED")
                        {
                            <span class="badge bg-success">
                                COMPLETED
                            </span>
                        }
                        else if (Model.Project?.Status == "ACTIVE")
                        {
                            <span class="badge bg-primary">
                                ACTIVE
                            </span>
                        }
                        else if (Model.Project?.Status == "PLANNING")
                        {
                            <span class="badge bg-warning text-dark">
                                PLANNING
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Project?.Status
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CERTIFICATE -->

    <div class="card mb-4">
        <div class="card-header">
            <span class="fw-semibold">
                Certificate
            </span>
        </div>
        <div class="card-body text-center">
            @if (Model.Certificates != null &&
                 Model.Certificates.Any())
            {
                <!-- CERTIFICATE ALREADY ISSUED -->
                <div class="alert alert-success">
                    <h5>
                        Certificate Issued
                    </h5>
                    <p class="mb-0">
                        A certificate has already been issued
                        for this volunteer and project.
                    </p>

                </div>
                <button type="button"
                        class="btn btn-secondary"
                        disabled>
                    Certificate Issued
                </button>
                @if (Model.Certificates.First().IssuedDate.HasValue)
                {
                    <div class="small text-muted mt-1">
                        Issued:
                        @(Model.Certificates.FirstOrDefault()?.IssuedDate?.ToString("dd MMM yyyy") ?? "Date not available")
                    </div>
                }
            }
            else if (Model.Status == "GENERATED"
                     && Model.Project?.Status == "COMPLETED")
            {
                <div class="alert alert-success">
                    <h5>
                        Report Ready
                    </h5>
                    <p class="mb-0">
                        The report is GENERATED and the project
                        is COMPLETED. The certificate can now
                        be issued.
                    </p>
                </div>
                <form asp-controller="ManagerCertificates"
                      asp-action="Generate"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="reportId"
                           value="@Model.ReportId" />
                    <button type="submit"
                            class="btn btn-primary"
                            onclick="return confirm('Issue a certificate for this volunteer?');">
                        Issue Certificate
                    </button>
                </form>
            }
            else if (Model.Project?.Status == "ACTIVE")
            {
                <div class="alert alert-warning">
                    <h5>
                        Certificate Not Available
                    </h5>
                    <p class="mb-0">
                        The project is currently
                        <strong>ACTIVE</strong>.
                        The manager must mark the project
                        as <strong>COMPLETED</strong> before
                        a certificate can be issued.
                    </p>
                </div>
                <button type="button"
                        class="btn btn-secondary"
                        disabled>
                    Certificate Unavailable
                </button>
            }
            else if (Model.Project?.Status == "PLANNING")
            {
                <div class="alert alert-warning">
                    <h5>
                        Certificate Not Available
                    </h5>
                    <p class="mb-0">
                        The project is still in
                        <strong>PLANNING</strong>.
                        The project must be completed before
                        a certificate can be issued.
                    </p>
                </div>
                <button type="button"
                        class="btn btn-secondary"
                        disabled>
                    Certificate Unavailable
                </button>
            }
            else
            {
                <div class="alert alert-secondary">
                    <p class="mb-0">
                        A certificate can only be issued after
                        the report is <strong>GENERATED</strong>
                        and the project is
                        <strong>COMPLETED</strong>.
                    </p>
                </div>
                <button type="button"
                        class="btn btn-secondary"
                        disabled>
                    Certificate Unavailable
                </button>
            }
        </div>
    </div>

    <div class="text-center">
        <a asp-controller="ManagerReport"
           asp-action="Index"
           class="btn btn-primary me-2">
            Back to Reports
        </a>
        <a asp-controller="Manager"
           asp-action="Index"
           class="btn btn-secondary">
            Dashboard
        </a>
    </div>
</div>