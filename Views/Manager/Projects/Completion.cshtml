
@using VolunteerHub.Controllers
@model VolunteerHub.Models.Project

@{
    ViewData["Title"] = "Project Completion Review";

    // Gets the list of volunteer completion rows from ViewBag.
    var rows = ViewBag.CompletionRows
        as List<ManagerCompletionRow>
        ?? new List<ManagerCompletionRow>();

    // Check if the project is ready for completion based on the ViewBag value.
    bool projectReady =
        ViewBag.ProjectReady != null &&
        (bool)ViewBag.ProjectReady;
}
<div class="container-fluid py-4">

    <!-- PAGE HEADER:-->

    <div class="vh-dashboard-header mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="small text-uppercase fw-semibold mb-2"
                     style="letter-spacing: 1px; color: #8FAADC;">
                    VolunteerHub Management
                </div>
                <h1 class="mb-2">
                    Project Completion Review
                </h1>
                <p class="mb-2">
                    Review volunteer completion before closing the project.
                </p>
                <p class="mb-0">
                    Manager:
                    <strong>
                        @ViewBag.FirstName @ViewBag.LastName
                    </strong>
                </p>
            </div>
        </div>
    </div>

    <!-- SUCCESS -->

    @if (TempData["SuccessMessage"] != null)
    {
        <!-- Uses Bootstrap styling to show a green success alert. -->
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <strong>Success:</strong>
            <!-- Displays the success message stored in TempData. -->
            @TempData["SuccessMessage"]

            <!-- Adds a button that allows the manager to close the alert. -->
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- ERROR: Displays an error message when one is available. -->

    @if (TempData["ErrorMessage"] != null)
    {
        <!-- Uses Bootstrap styling to show a red error alert. -->
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <strong>Cannot complete action:</strong>
            <!-- Displays the error message stored in TempData. -->
            @TempData["ErrorMessage"]
            <!-- Adds a button that allows the manager to close the alert. -->
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    <!-- PROJECT INFORMATION: Displays the details of the selected project. -->
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <!-- Labels the project information section. -->
                <span class="fw-semibold">
                    Project Information
                </span>
                <!-- Displays the project's unique ID. -->
                <span class="badge bg-light text-dark">
                    Project ID: @Model.ProjectId
                </span>
            </div>
        </div>
        <div class="card-body">
            <div class="row">

                <!-- Displays the project name. -->
                <div class="col-md-6 mb-4">
                    <strong>Project Name</strong>
                    <div class="mt-1">
                        @Model.ProjectName
                    </div>
                </div>

                <!-- Displays the location if one has been entered. -->
                <div class="col-md-6 mb-4">
                    <strong>Location</strong>
                    <div class="mt-1">

                        <!-- Checks whether the location contains a value. -->
                        @if (!string.IsNullOrWhiteSpace(Model.Location))
                        {
                            @Model.Location
                        }
                        else
                        {
                            <span class="text-muted">
                                Not specified
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <strong>Start Date</strong>
                    <div class="mt-1">
                        @Model.StartDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <strong>End Date</strong>
                    <div class="mt-1">

                        @if (Model.EndDate.HasValue)
                        {
                            @Model.EndDate.Value.ToString("dd MMMM yyyy")
                        }
                        else
                        {
                            <span class="text-muted">
                                Not specified
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <strong>Current Status</strong>
                    <div class="mt-1">

                        @if (!string.IsNullOrWhiteSpace(Model.Status))
                        {
                            <span class="badge bg-primary">
                                @Model.Status
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not specified
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PROJECT READINESS-->

    @if (projectReady)
    {
        <div class="alert alert-success mb-4">
            <h4 class="alert-heading">
                Project Ready for Completion
            </h4>

            <p class="mb-0">
                All active volunteer assignments have been completed
                and all attendance records have been verified.

                The manager can now mark this project as
                <strong>COMPLETED</strong>.
            </p>
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-4">
            <h4 class="alert-heading">
                Project Not Ready
            </h4>

            <p class="mb-0">
                The project cannot be completed yet.

                Every active volunteer assignment must be
                <strong>COMPLETED</strong>, and all attendance records
                must be verified by the volunteers.
            </p>
        </div>
    }

    <!-- VOLUNTEER COMPLETION (table)-->

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">

                <span class="fw-semibold">
                    Volunteer Completion
                </span>
                <span class="badge bg-light text-dark">
                    @rows.Count Volunteer(s)
                </span>
            </div>
        </div>

        <div class="card-body">

            <!-- Check are thre volunteers to display -->
            @if (rows.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Volunteer</th>
                                <th>VID</th>
                                <th>Staff</th>
                                <th>Assignment</th>
                                <th>Attendance</th>
                                <th>Verified</th>
                                <th>Total Hours</th>
                                <th>Completion</th>
                                <th>Report</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @row.VolunteerName
                                        </strong>
                                    </td>
                                    <td>
                                        @row.Vid
                                    </td>
                                    <td>
                                        @row.StaffName
                                    </td>
                                    <td>
                                        @if (string.Equals(
                                            row.AssignmentStatus,
                                            "COMPLETED",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                COMPLETED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @row.AssignmentStatus
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.HasAttendance)
                                        {
                                            @row.AttendanceCount
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                None
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @row.VerifiedAttendanceCount
                                        /
                                        @row.AttendanceCount
                                    </td>
                                    <td>
                                        <strong>
                                            @row.TotalHours.ToString("0.00")
                                        </strong>
                                        hours
                                    </td>
                                    <td>
                                        @if (row.VolunteerCompleted)
                                        {
                                            <span class="badge bg-success">
                                                Ready
                                            </span>
                                        }
                                        else if (!row.HasAttendance)
                                        {
                                            <span class="badge bg-danger">
                                                No Attendance
                                            </span>
                                        }
                                        else if (!row.AllAttendanceVerified)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Awaiting Verification
                                            </span>
                                        }
                                        else if (!row.AssignmentCompleted)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Staff Completion Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Incomplete
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.VolunteerCompleted)
                                        {
                                            <form asp-controller="ManagerReport"
                                                  asp-action="Generate"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="assignId"
                                                       value="@row.AssignId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary">
                                                    Generate Report
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not Ready
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <h4>
                        No Active Volunteer Assignments
                    </h4>
                    <p class="text-muted mb-0">
                        This project does not currently have any
                        non-declined volunteer assignments.
                    </p>
                </div>
            }
        </div>
    </div>
    <div class="text-center mt-4">
        @if (projectReady)
        {
            <form asp-controller="ManagerProjects"
                  asp-action="CompleteProject"
                  asp-route-id="@Model.ProjectId"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success btn-lg"
                        onclick="return confirm('Are you sure you want to mark this project as COMPLETED?');">
                    Mark Project as COMPLETED
                </button>

            </form>
        }
        else
        {
            <button type="button"
                    class="btn btn-secondary btn-lg"
                    disabled>
                Project Not Ready for Completion
            </button>
        }

    </div>

    <div class="text-center mt-4">
        <a asp-controller="ManagerProjects"
           asp-action="Details"
           asp-route-id="@Model.ProjectId"
           class="btn btn-primary me-2">
            Back to Project
        </a>
        <a asp-controller="ManagerReport"
           asp-action="Index"
           class="btn btn-info me-2">
            View Reports
        </a>
        <a asp-controller="Manager"
           asp-action="Index"
           class="btn btn-secondary">
            Dashboard
        </a>
    </div>
    <div class="card mt-4">
        <div class="card-header">
            <span class="fw-semibold">
                Project Completion & Report Rules
            </span>
        </div>
        <div class="card-body">
            <ol class="mb-0">
                <li>
                    Staff must record attendance for volunteers.
                </li>
                <li>
                    Volunteers must verify their attendance hours.
                </li>
                <li>
                    Staff must mark each volunteer assignment as
                    <strong>COMPLETED</strong>.
                </li>
                <li>
                    All active volunteer assignments must be completed.
                </li>
                <li>
                    All attendance records must be verified.
                </li>
                <li>
                    A report can then be generated for each completed
                    volunteer.
                </li>
                <li>
                    The report's total hours are calculated automatically
                    from the volunteer's attendance records.
                </li>
                <li>
                    The manager can then mark the project as
                    <strong>COMPLETED</strong>.
                </li>
            </ol>
        </div>
    </div>
</div>
